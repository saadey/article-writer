# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit .env. It is already listed in .gitignore.

# Required: YouTube Data API v3 key (see README, "Get a YouTube API key").
YOUTUBE_API_KEY=

# Used later (step 3, article writing): Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: proxy for transcript requests, only needed if YouTube blocks your IP.
# Example: http://user:password@proxy-host:port
TRANSCRIPT_PROXY_URL=
